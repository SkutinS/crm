# Copy to .env and adjust for your environment.

# SQLite for local dev (default). To switch to Postgres later:
# DATABASE_URL=postgresql+psycopg://crm:crm@localhost:5432/crm
DATABASE_URL=sqlite:///./crm.db

# Generate a real secret for anything beyond local dev, e.g.:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-key-change-me-in-production

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
